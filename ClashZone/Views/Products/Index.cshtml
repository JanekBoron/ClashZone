@model IEnumerable<ClashZone.App.Domains.ProductDomain>
@{
    ViewData["Title"] = "Produkty (Admin)";
}
@await Html.PartialAsync("~/Views/Shared/_CoinShopStyles.cshtml")

<div class="container mt-4" style="background-color:#111; padding:20px; border-radius:10px; color:#f8f9fa;">
    <h2 class="mb-3" style="color:#FF2B3E;">Produkty</h2>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-2">
        <a class="btn-cc d-inline-block" href="@Url.Action("Create")">+ Dodaj</a>
        <input type="search" class="form-control cc-table-search" data-table-search="productsTable"
               placeholder="Szukaj produktu..." aria-label="Szukaj produktu" autocomplete="off" />
    </div>
    <table id="productsTable" data-paginate data-page-size="10" class="table table-dark table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nazwa</th>
                <th>Cena</th>
                <th>Aktywny</th>
                <th>Stock</th>
                <th>Kategoria</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Name</td>
                    <td>C @p.ClashCoins</td>
                    <td>@(p.IsActive ? "✓" : "-")</td>
                    <td>@(p.Stock?.ToString() ?? "∞")</td>
                    <td>@p.Category?.Name</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-light" href="@Url.Action("Edit", new { id = p.Id })">Edytuj</a>
                        <form method="post" action="@Url.Action("ConfirmDelete", new { id = p.Id })" onsubmit="return confirm('Czy na pewno chcesz usunąć ten produkt?');" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
}
