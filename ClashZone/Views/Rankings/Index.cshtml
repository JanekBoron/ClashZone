@model ClashZone.App.ViewModels.RankingViewModel

@{
    ViewData["Title"] = "Rankingi";
    var isLol = GameCatalog.IsLol(Model.SelectedGame);
}

<h2 class="my-4" style="color: var(--cz-red);">Rankingi graczy</h2>

<ul class="nav nav-tabs mb-3" role="tablist">
    @foreach (var g in GameCatalog.AllGames)
    {
        var active = string.Equals(g, Model.SelectedGame, StringComparison.OrdinalIgnoreCase);
        <li class="nav-item">
            <a class="nav-link @(active ? "active" : "")"
               style="@(active ? "background-color: var(--cz-red); color:#fff; border-color: var(--cz-red);" : "color: var(--cz-red);")"
               asp-controller="Rankings" asp-action="Index" asp-route-game="@g" asp-route-search="@Model.SearchTerm">@g</a>
        </li>
    }
</ul>

<form method="get" asp-controller="Rankings" asp-action="Index" class="row g-2 mb-3 align-items-center">
    <input type="hidden" name="game" value="@Model.SelectedGame" />
    <div class="col-sm-8 col-md-5">
        <input type="search" name="search" value="@Model.SearchTerm" class="form-control"
               placeholder="Szukaj gracza po nazwie..."
               style="background-color: var(--cz-gray); color:#fff; border-color: var(--cz-red);" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn" style="background-color: var(--cz-red); color:#fff;">Szukaj</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="col-auto">
            <a class="btn btn-outline-light" asp-controller="Rankings" asp-action="Index" asp-route-game="@Model.SelectedGame">Wyczyść</a>
        </div>
    }
</form>

<div class="table-responsive">
    <table class="table" style="color: #fff; background-color: var(--cz-black);">
        <thead>
            <tr style="background-color: var(--cz-gray); color: #fff;">
                <th scope="col">#</th>
                <th scope="col">Gracz</th>
                @if (isLol)
                {
                    <th scope="col">Ulubiona postać</th>
                    <th scope="col">KDA</th>
                }
                else
                {
                    <th scope="col">Średnia K/D</th>
                }
                <th scope="col">Zabójstwa</th>
                <th scope="col">Śmierci</th>
                @if (isLol)
                {
                    <th scope="col">Asysty</th>
                }
                <th scope="col">Mecze</th>
            </tr>
        </thead>
        <tbody>
            @{
                var startRank = (Model.CurrentPage - 1) * Model.PageSize;
            }
            @if (Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="@(isLol ? 7 : 5)" class="text-center text-muted py-3">
                        @(string.IsNullOrWhiteSpace(Model.SearchTerm)
                            ? "Brak danych rankingowych dla tej gry."
                            : $"Brak graczy pasujących do \"{Model.SearchTerm}\".")
                    </td>
                </tr>
            }
            else
            {
                for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];
                    var stat = row.Stat;
                    var rank = startRank + i + 1;
                    <tr>
                        <td>@rank</td>
                        <td>@(stat.User.DisplayName ?? stat.User.UserName)</td>
                        @if (isLol)
                        {
                            <td>@(row.FavoriteChampion ?? "-")</td>
                            <td>@stat.AverageKDA.ToString("0.00")</td>
                        }
                        else
                        {
                            <td>@stat.AverageKD.ToString("0.00")</td>
                        }
                        <td>@stat.TotalKills</td>
                        <td>@stat.TotalDeaths</td>
                        @if (isLol)
                        {
                            <td>@stat.TotalAssists</td>
                        }
                        <td>@stat.MatchesPlayed</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Ranking pagination">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" style="background-color: var(--cz-red); color: #fff; border: none;" asp-controller="Rankings" asp-action="Index" asp-route-game="@Model.SelectedGame" asp-route-search="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage - 1)">Poprzednia</a>
                </li>
            }
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : null)">
                    <a class="page-link" style="background-color: var(--cz-black); color: var(--cz-red); border: none;" asp-controller="Rankings" asp-action="Index" asp-route-game="@Model.SelectedGame" asp-route-search="@Model.SearchTerm" asp-route-page="@p">@p</a>
                </li>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" style="background-color: var(--cz-red); color: #fff; border: none;" asp-controller="Rankings" asp-action="Index" asp-route-game="@Model.SelectedGame" asp-route-search="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage + 1)">Następna</a>
                </li>
            }
        </ul>
    </nav>
}
