@model ClashZone.App.ViewModels.SeasonFormViewModel
@{
    ViewData["Title"] = "Edytuj sezon";
}

<div class="container mt-4" style="background-color:#111; padding:20px; border-radius:10px; color:#f8f9fa; max-width:820px;">
    <h2 class="mb-3" style="color:#FF2B3E;">Edytuj sezon</h2>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @await Html.PartialAsync("_SeasonFormFields", Model)

        <button type="submit" class="btn mt-3" style="background-color:#FF2B3E;color:#fff;">Zapisz zmiany</button>
        <a asp-action="Manage" class="btn btn-outline-light mt-3">Anuluj</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
