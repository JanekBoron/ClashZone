@model ClashZone.App.ViewModels.TournamentFormViewModel

@{
    ViewData["Title"] = "Edytuj turniej";
    var allowedFormatsJson = System.Text.Json.JsonSerializer.Serialize(
        GameCatalog.AllGames.ToDictionary(g => g, g => GameCatalog.AllowedFormats(g)));
    var defaultRulesJson = System.Text.Json.JsonSerializer.Serialize(
        GameCatalog.AllGames.ToDictionary(g => g, g => string.Join("\n", GameCatalog.DefaultRules(g))));

    string[] prizes =
    {
        Model.FirstPlacePrize ?? string.Empty,
        Model.SecondPlacePrize ?? string.Empty,
        Model.ThirdPlacePrize ?? string.Empty
    };

    int[] prizeCoins = new int[3];
    for (int i = 0; i < 3; i++)
    {
        var p = prizes[i].Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length > 0 && int.TryParse(p[0], out var coins))
        {
            prizeCoins[i] = coins;
        }
    }
}
<div class="container mt-4" style="background-color:#111; padding:20px; border-radius:10px; color:#f8f9fa;">
    <h2 style="color:#FF2B3E;">Edytuj turniej</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="GameTitle" class="form-label"></label>
            <select asp-for="GameTitle" id="gameTitleSelect" class="form-select">
                @foreach (var g in GameCatalog.AllGames)
                {
                    <option value="@g">@g</option>
                }
            </select>
            <span asp-validation-for="GameTitle" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="datetime-local" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Format" class="form-label">Format drużyn</label>
            <select asp-for="Format" id="formatSelect" class="form-select">
                <option value="1v1">1v1</option>
                <option value="2v2">2v2</option>
                <option value="5v5">5v5</option>
            </select>
            <span asp-validation-for="Format" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Rules" class="form-label">Reguły turnieju</label>
            <textarea asp-for="Rules" id="rulesTextarea" class="form-control" rows="5"
                      placeholder="Każda reguła w osobnej linii"></textarea>
            <small class="text-muted">Każdą regułę wpisz w osobnej linii.</small>
            <span asp-validation-for="Rules" class="text-danger"></span>
        </div>

        <div class="mb-2"><strong style="color:#FF2B3E;">Nagrody (ClashCoins)</strong></div>

        <div class="mb-3 p-3" style="background-color:#0A0A0A; border:1px solid #333; border-radius:8px;">
            <div class="mb-1"><strong>1. miejsce</strong></div>
            <label class="form-label">Ilość ClashCoins</label>
            <input name="prizeCoins1" type="number" min="0" class="form-control" placeholder="Ilość ClashCoins" value="@prizeCoins[0]" />
        </div>

        <div class="mb-3 p-3" style="background-color:#0A0A0A; border:1px solid #333; border-radius:8px;">
            <div class="mb-1"><strong>2. miejsce</strong></div>
            <label class="form-label">Ilość ClashCoins</label>
            <input name="prizeCoins2" type="number" min="0" class="form-control" placeholder="Ilość ClashCoins" value="@prizeCoins[1]" />
        </div>

        <div class="mb-3 p-3" style="background-color:#0A0A0A; border:1px solid #333; border-radius:8px;">
            <div class="mb-1"><strong>3. miejsce</strong></div>
            <label class="form-label">Ilość ClashCoins</label>
            <input name="prizeCoins3" type="number" min="0" class="form-control" placeholder="Ilość ClashCoins" value="@prizeCoins[2]" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsPublic" class="form-check-input" />
            <label asp-for="IsPublic" class="form-check-label">
                Publiczny (widoczny dla wszystkich)
            </label>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsPremium" class="form-check-input" />
            <label asp-for="IsPremium" class="form-check-label">
                Turniej premium (dostępny tylko dla pakietu Premium/Ultra)
            </label>
        </div>

        <button type="submit" class="btn" style="background-color:#FF2B3E; color:#fff;">Zapisz zmiany</button>
    </form>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script id="allowedFormatsData" type="application/json">@Html.Raw(allowedFormatsJson)</script>
        <script id="defaultRulesData" type="application/json">@Html.Raw(defaultRulesJson)</script>
        <script src="~/js/tournament-form.js" asp-append-version="true"></script>
    }
</div>