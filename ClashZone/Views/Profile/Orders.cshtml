@model IEnumerable<ClashZone.App.Domains.ProductRedeemDomain>

@{
    ViewData["Title"] = "Twoje zamówienia";
}

<style>
    .order-card {
        border: 1px solid #444;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
        background-color: #0A0A0A;
    }

    .order-name {
        font-size: 20px;
        font-weight: bold;
        color: #FF2B3E;
    }

    .order-meta {
        margin-top: 10px;
        font-size: 14px;
        color: #aaa;
    }
</style>

<div class="container mt-4" style="background-color:#111; padding:20px; border-radius:10px; color:#f8f9fa;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0" style="color:#FF2B3E;">Twoje zamówienia</h2>
        <a asp-action="Index" class="btn btn-sm btn-outline-light">Wróć do profilu</a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">Nie masz jeszcze żadnych zamówień.</p>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="order-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="order-name">@(order.Product?.Name ?? "Produkt")</div>
                    <span class="badge @OrderStatus.BadgeClass(order.Status)">@OrderStatus.Label(order.Status)</span>
                </div>

                <div class="order-meta">
                    Koszt: <strong>@(order.Product?.ClashCoins ?? 0)</strong> Clash Coins <br />
                    Data zamówienia: @order.RedeemedAt.ToString("dd.MM.yyyy HH:mm")
                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                    {
                        <br />
                        <span>Uwagi: @order.Notes</span>
                    }
                </div>
            </div>
        }
    }
</div>
