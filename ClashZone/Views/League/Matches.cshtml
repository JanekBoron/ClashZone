@model ClashZone.App.ViewModels.LeagueMatchesViewModel
@{
    var s = Model.Season;
    ViewData["Title"] = $"Mecze - {s.Name}";
    var scoreLabel = GameCatalog.ScoreLabel(s.Game);
}

<div class="container mt-4" style="background-color:#111; padding:20px; border-radius:10px; color:#f8f9fa;">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="mb-0">@s.Name - Mecze</h2>
    </div>
    <hr style="border-color:#444;" />

    @await Html.PartialAsync("_LeagueNav", (s.Id, "Matches"))

    @if (TempData["LeagueInfo"] != null)
    {
        <div class="alert alert-success">@TempData["LeagueInfo"]</div>
    }

    @if (!Model.Matches.Any())
    {
        <p class="text-muted">Brak meczów. Organizator może wygenerować mecze otwarcia z poziomu przeglądu sezonu.</p>
    }
    else
    {
        @foreach (var weekGroup in Model.Matches.GroupBy(m => new { m.Match.IsPlayoff, m.Match.Week }))
        {
            <h5 class="mt-3" style="color:#FF2B3E;">
                @(weekGroup.Key.IsPlayoff ? "Play-off" : $"Tydzień {weekGroup.Key.Week}")
            </h5>
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Gospodarz</th>
                        <th class="text-center">@scoreLabel</th>
                        <th class="text-end">Gość</th>
                        <th>Termin</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in weekGroup)
                    {
                        <tr>
                            <td>@item.Team1Name</td>
                            <td class="text-center">
                                @if (item.Match.IsPlayed)
                                {
                                    <strong>@item.Match.HomeScore</strong> <span>-</span> <strong>@item.Match.AwayScore</strong>
                                }
                                else
                                {
                                    <span class="text-muted">vs</span>
                                }
                            </td>
                            <td class="text-end">@item.Team2Name</td>
                            <td>@item.ScheduleLabel</td>
                            <td class="text-end">
                                @if (item.Match.IsPlayed)
                                {
                                    <a asp-action="MatchDetails" asp-route-seasonId="@s.Id" asp-route-id="@item.Match.Id" class="btn btn-sm" style="background-color:#FF2B3E;color:#fff;">Szczegóły</a>
                                }
                                else if (!item.Match.IsPlayoff)
                                {
                                    <a asp-action="Schedule" asp-route-matchId="@item.Match.Id" class="btn btn-sm btn-outline-light">Termin</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>
