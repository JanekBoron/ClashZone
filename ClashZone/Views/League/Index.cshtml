@model IEnumerable<ClashZone.App.Domains.SeasonDomain>
@{
    ViewData["Title"] = "Liga";
    string StatusLabel(int s) => ((SeasonStatus)s) switch
    {
        SeasonStatus.Registration => "Rejestracja",
        SeasonStatus.RegularSeason => "Sezon regularny",
        SeasonStatus.Playoffs => "Play-off",
        SeasonStatus.Completed => "Zakończony",
        _ => "—"
    };
}

<div class="container mt-4" style="background-color:#111; padding:20px; border-radius:10px; color:#f8f9fa;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0" style="color:#FF2B3E;">Liga</h2>
    </div>
    <p class="text-muted">Sezony ligowe w stylu FACEIT — zarejestruj drużynę, rywalizuj w sezonie regularnym i awansuj do play-off.</p>

    @if (!Model.Any())
    {
        <p class="text-muted">Brak sezonów. Zajrzyj wkrótce!</p>
    }
    else
    {
        <div>
            @foreach (var s in Model)
            {
                <div class="mb-3 p-3" style="background-color:#0A0A0A; border:1px solid #444; border-radius:8px; display:flex; justify-content:space-between; align-items:center; color:#f8f9fa;">
                    <div>
                        <h5 class="mb-1" style="color:#FF2B3E;">@s.Name</h5>
                        <small>@s.StartDate.ToString("dd.MM.yyyy") • Format: @s.Format • @s.Game</small>
                        <div>
                            <span class="badge" style="background-color:#FF2B3E;color:#fff;">@StatusLabel(s.Status)</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-sm" style="background-color:#FF2B3E; color:#fff;" asp-action="Details" asp-route-id="@s.Id">Zobacz sezon</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
