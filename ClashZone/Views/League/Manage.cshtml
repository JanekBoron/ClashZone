@model IEnumerable<ClashZone.App.Domains.SeasonDomain>
@{
    ViewData["Title"] = "Zarządzanie ligą";
    string StatusLabel(int s) => ((SeasonStatus)s) switch
    {
        SeasonStatus.Registration => "Rejestracja",
        SeasonStatus.RegularSeason => "Sezon regularny",
        SeasonStatus.Playoffs => "Play-off",
        SeasonStatus.Completed => "Zakończony",
        _ => "-"
    };
}

<div class="container mt-4" style="background-color:#111; padding:20px; border-radius:10px; color:#f8f9fa;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0" style="color:#FF2B3E;">Zarządzanie ligą</h2>
        <a class="btn" style="background-color:#FF2B3E;color:#fff;" asp-action="Create">Nowy sezon</a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">Brak sezonów.</p>
    }
    else
    {
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Gra</th>
                    <th>Format</th>
                    <th>Status</th>
                    <th>Start</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.Game</td>
                        <td>@s.Format</td>
                        <td><span class="badge" style="background-color:#FF2B3E;color:#fff;">@StatusLabel(s.Status)</span></td>
                        <td>@s.StartDate.ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-light" asp-action="Details" asp-route-id="@s.Id">Otwórz</a>
                            <a class="btn btn-sm" style="background-color:#FF2B3E;color:#fff;" asp-action="Edit" asp-route-id="@s.Id">Edytuj</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
