@model ClashZone.App.ViewModels.SeasonDetailsViewModel
@{
    var s = Model.Season;
    ViewData["Title"] = $"Tabela - {s.Name}";
}

<div class="container mt-4" style="background-color:#111; padding:20px; border-radius:10px; color:#f8f9fa;">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="mb-0">@s.Name - Tabela</h2>
    </div>
    <hr style="border-color:#444;" />

    @await Html.PartialAsync("_LeagueNav", (s.Id, "Standings"))

    @if (!Model.Standings.Any())
    {
        <p class="text-muted">Brak rozegranych meczów - tabela pojawi się po pierwszych wynikach.</p>
    }
    else
    {
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Drużyna</th>
                    <th class="text-center">Mecze</th>
                    <th class="text-center">W</th>
                    <th class="text-center">P</th>
                    <th class="text-center">Win %</th>
                </tr>
            </thead>
            <tbody>
                @{ int rank = 1; }
                @foreach (var row in Model.Standings)
                {
                    bool playoff = rank <= s.PlayoffSpots;
                    <tr>
                        <td>
                            <span class="badge" style="background-color:@(playoff ? "#FF2B3E" : "#6c757d"); color:#fff;">@rank</span>
                        </td>
                        <td>@row.TeamName</td>
                        <td class="text-center">@row.Played</td>
                        <td class="text-center">@row.Wins</td>
                        <td class="text-center">@row.Losses</td>
                        <td class="text-center">@((row.WinRatio * 100).ToString("0"))%</td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
        <small class="text-muted">Pozycje oznaczone na czerwono kwalifikują się do play-off (top @s.PlayoffSpots).</small>
    }
</div>
