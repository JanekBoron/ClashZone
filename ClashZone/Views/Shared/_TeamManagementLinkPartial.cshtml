@using Microsoft.AspNetCore.Identity
@using ClashZone.DataAccess.Models
@inject SignInManager<ClashUser> SignInManager


@if (SignInManager.IsSignedIn(User) && !User.IsInRole("Admin") && !User.IsInRole("Organizer"))
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Team" asp-action="Index">Zarządzanie drużyną</a>
    </li>
}
